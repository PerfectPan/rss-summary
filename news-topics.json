[
  {
    "id": "ai-model-releases",
    "label": "AI 模型与 Agent 发布",
    "icon": "🤖",
    "enabled": true,
    "sourcePolicy": "official",
    "maxItems": 2,
    "queries": [
      {
        "id": "frontier-model-release",
        "text": "OpenAI、Anthropic、Google DeepMind、Meta 或 xAI 正式发布新模型、Agent 或 API；只要官方公告",
        "intent": "model-release",
        "glm": {
          "query": "OpenAI Anthropic Google DeepMind new model announcement",
          "domains": ["openai.com", "anthropic.com", "deepmind.google", "blog.google", "x.ai"]
        },
        "subjectAny": ["OpenAI", "Anthropic", "Google DeepMind", "Meta", "xAI"],
        "eventAny": ["正式发布", "正式上线", "开放 API", "进入 GA", "general availability", "launches", "released", "introducing"],
        "excludedAny": ["教程", "评测", "传闻", "预测", "盘点", "tutorial", "review", "rumor", "prediction", "roundup"]
      },
      {
        "id": "coding-agent-release",
        "text": "Codex、Claude Code、Gemini CLI、GitHub Copilot、Cursor 或 Windsurf 进入 GA、发布重大版本或破坏性变更；只要官方公告",
        "intent": "developer-change",
        "glm": {
          "query": "Codex Claude Code GitHub Copilot Cursor major release",
          "domains": ["openai.com", "anthropic.com", "github.blog", "cursor.com", "windsurf.com"]
        },
        "subjectAny": ["Codex", "Claude Code", "Gemini CLI", "GitHub Copilot", "Cursor", "Windsurf"],
        "eventAny": ["进入 GA", "重大版本", "破坏性变更", "general availability", "major release", "breaking change"],
        "excludedAny": ["教程", "评测", "传闻", "预测", "盘点", "tutorial", "review", "rumor", "prediction", "roundup"]
      }
    ]
  },
  {
    "id": "developer-tools",
    "label": "开发工具关键变更",
    "icon": "💻",
    "enabled": true,
    "sourcePolicy": "official",
    "maxItems": 2,
    "queries": [
      {
        "id": "runtime-toolchain-change",
        "text": "TypeScript、Rust、Node.js、Deno、Bun 或主流 IDE 发布重大版本、弃用、破坏性变更或安全更新；只要项目官方公告",
        "intent": "developer-change",
        "glm": {
          "query": "TypeScript Rust Node.js Deno Bun release security update",
          "domains": ["devblogs.microsoft.com", "blog.rust-lang.org", "nodejs.org", "deno.com", "bun.sh"]
        },
        "subjectAny": ["TypeScript", "Rust", "Node.js", "Deno", "Bun", "IDE"],
        "eventAny": ["重大版本", "弃用", "破坏性变更", "安全更新", "major release", "breaking change", "deprecation", "security update"],
        "excludedAny": ["教程", "评测", "传闻", "预测", "盘点", "tutorial", "review", "rumor", "prediction", "roundup"]
      }
    ]
  },
  {
    "id": "infrastructure-security",
    "label": "基础设施与安全事件",
    "icon": "🛡️",
    "enabled": true,
    "sourcePolicy": "authoritative",
    "maxItems": 2,
    "queries": [
      {
        "id": "cloud-service-incident",
        "text": "AWS、Azure、Google Cloud 或 Cloudflare 发生大规模服务中断、数据泄露或安全事件；只要官方通报或状态页",
        "intent": "service-incident",
        "glm": {
          "query": "AWS Azure Google Cloud Cloudflare service outage incident",
          "domains": ["aws.amazon.com", "azure.status.microsoft", "status.cloud.google.com", "cloudflarestatus.com", "blog.cloudflare.com"]
        },
        "subjectAny": ["AWS", "Azure", "Google Cloud", "Cloudflare"],
        "eventAny": ["服务中断", "大规模中断", "故障", "数据泄露", "安全事件", "outage", "service disruption", "data breach", "security incident"],
        "excludedAny": ["教程", "评测", "传闻", "预测", "盘点", "tutorial", "review", "rumor", "prediction", "roundup"]
      },
      {
        "id": "open-source-security",
        "text": "开源开发工具发生高危 CVE、供应链攻击或紧急弃用；只要项目维护者或安全机构公告",
        "intent": "security-advisory",
        "glm": {
          "query": "GitHub npm package critical vulnerability security advisory",
          "domains": ["github.blog", "cisa.gov"]
        },
        "subjectAny": ["开源", "GitHub", "npm", "PyPI", "软件包", "dependency", "package"],
        "eventAny": ["CVE-", "高危漏洞", "供应链攻击", "紧急弃用", "critical vulnerability", "supply-chain attack", "security advisory"],
        "excludedAny": ["教程", "评测", "传闻", "预测", "盘点", "tutorial", "review", "rumor", "prediction", "roundup"]
      }
    ]
  },
  {
