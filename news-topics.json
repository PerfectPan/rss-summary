  },
  {
    "id": "capital-industry",
    "label": "重大资本事件",
    "icon": "💰",
    "enabled": true,
    "sourcePolicy": "authoritative",
    "maxItems": 1,
    "queries": [
      {
        "id": "major-capital-event",
