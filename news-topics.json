        "glm": {
          "query": "AI semiconductor data regulation takes effect official",
          "domains": ["gov.cn", "cac.gov.cn", "ec.europa.eu", "ftc.gov"]
        },
        "subjectAny": ["AI", "人工智能", "模型", "芯片", "数据"],
        "eventAny": ["正式发布", "生效", "通过", "裁定", "takes effect", "effective", "regulation", "ruling"],
        "excludedAny": ["解读", "观点", "传闻", "预测", "盘点", "opinion", "rumor", "prediction", "roundup"]
