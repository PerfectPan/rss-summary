{
  "timezoneOffsetEnv": "FEED_TIMEZONE_OFFSET",
  "quotas": {
    "maxTotal": 8,
    "updates": 5,
    "opensource": 4
  },
  "frontendBias": {
    "languages": ["TypeScript", "JavaScript"],
    "repoTopics": ["react", "nextjs", "mcp", "agent", "ai"],
    "updateKeywords": [
      "LLM",
      "agent",
      "MCP",
      "coding",
      "IDE",
      "SDK",
      "TypeScript",
      "JavaScript",
      "React",
      "Next.js",
      "browser",
      "OpenAI",
      "Anthropic",
      "Claude",
      "GPT",
      "Gemini",
      "Cursor",
      "Vercel",
      "Hugging Face",
      "devtools",
      "frontend",
      "Qwen",
      "DeepSeek",
      "Llama",
      "Mistral",
      "Kimi"
    ],
    "modelTitleHints": ["GPT", "Claude", "Gemini", "Llama", "Mistral", "Qwen", "DeepSeek", "Kimi", "LLM", "模型"]
  },
  "scoring": {
    "officialDomainBoost": 30,
    "hnPointsMaxScore": 30,
    "frontendKeywordBoost": 8,
    "frontendKeywordMaxHits": 3,
    "recencyMaxScore": 10,
    "crossSourceBoost": 15,
    "repoStarMaxScore": 50,
    "repoNewnessWeight": 2,
    "repoLanguageBoost": 10,
    "repoTopicBoost": 5,
    "repoTopicMaxHits": 3,
    "repoMissingDescriptionPenalty": 10,
    "repoMissingLanguagePenalty": 5
  },
  "hackerNews": {
    "minPoints": 80,
    "includeShowHn": true,
    "maxItems": 20
  },
  "githubSearch": {
    "createdWithinDays": 7,
    "minStars": 50,
    "languages": ["TypeScript", "JavaScript"],
    "topics": ["ai", "llm", "agent", "mcp"],
    "excludeNamePatterns": ["^awesome[-_]", "^awesome$"],
    "perPage": 8
  },
  "officialSearch": {
    "domains": [
      "openai.com",
      "anthropic.com",
      "ai.google.dev",
      "deepmind.google",
      "huggingface.co",
      "github.blog",
      "vercel.com",
      "cursor.com"
    ],
    "intents": [
      {
        "kind": "model",
        "query": "model release OR announcing OR launched API"
      },
      {
        "kind": "product",
        "query": "product launch OR changelog shipping developer"
      }
    ],
    "countPerQuery": 10
  }
}
