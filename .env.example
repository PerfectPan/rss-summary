# GitHub Home exact mode is the default.
# Run `rss-summary github-home login` once to create this storage state.
GITHUB_FEED_SOURCE=home
GITHUB_HOME_FETCH=conduit
GITHUB_HOME_STORAGE_STATE=.state/github-home-storage.json
# GITHUB_HOME_BROWSER_CHANNEL=chrome

# Optional: used for GitHub API enrichment and for GITHUB_FEED_SOURCE=events fallback.
GH_FEED_TOKEN=

# Defaults to PerfectPan.
GITHUB_USERNAME=PerfectPan

# Optional generic webhook endpoint. If omitted, the digest prints to stdout only.
NOTIFY_WEBHOOK_URL=

# Optional tuning.
FEED_EVENT_PAGES=3
FEED_PER_PAGE=100
FEED_WINDOW_HOURS=36
FEED_MAX_REPOS=30
FEED_MAX_PAPERS=8
FEED_INTERESTS=agent,coding-agent,llm,mcp,ai,rust,typescript,javascript,toolchain,bundler,vite,deno,testing,performance,skills
FEED_STATE_FILE=.state/feed-state.json
# FEED_ONLY_NEW=true
# FEED_OUTPUT_FORMAT=json

# RSS/Atom feeds are loaded from the repository feeds.json file.
# RSS_FEEDS_FILE=feeds.json
# INDUSTRY_FEEDS_FILE=industry-feeds.json
# INDUSTRY_STATE_FILE=.state/industry-state.json
# Inline overrides are isolated: RSS_FEEDS=... and INDUSTRY_FEEDS=...

# Required by the noon and evening Doubao web-search briefs.
DOUBAO_SEARCH_API_KEY=
# NEWS_TOPICS_FILE=/absolute/path/to/rss-summary/news-topics.json
# NEWS_SEARCH_COUNT_PER_QUERY=10
# NEWS_SEARCH_TIMEOUT_MS=15000

# Daily high-signal brief (rss-summary signal). Reuses GH_FEED_TOKEN for the
# GitHub repository Search API (optional, raises the unauthenticated quota) and
# DOUBAO_SEARCH_API_KEY for official-domain updates.
# SIGNAL_SOURCES_FILE=/absolute/path/to/rss-summary/signal-sources.json
# SIGNAL_SEARCH_TIMEOUT_MS=15000
