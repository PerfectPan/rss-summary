# GitHub Home exact mode is the default.
# Run `rss-summary github-home login` once to create this storage state.
GITHUB_FEED_SOURCE=home
GITHUB_HOME_FETCH=conduit
GITHUB_HOME_STORAGE_STATE=.state/github-home-storage.json
# GITHUB_HOME_BROWSER_CHANNEL=chrome
# If this machine reaches feeds through HTTP(S)_PROXY, let Node fetch use it.
# NODE_USE_ENV_PROXY=1
# Browser-first article research uses an isolated Chrome/Chromium context.
# RSS_ARTICLE_BROWSER_CHANNEL=chrome
# RSS_ARTICLE_BROWSER_HEADLESS=true
# RSS_ARTICLE_BROWSER_TIMEOUT_MS=30000

# Optional: used for GitHub API enrichment and for GITHUB_FEED_SOURCE=events fallback.
GH_FEED_TOKEN=

# Defaults to PerfectPan.
GITHUB_USERNAME=PerfectPan

# Optional generic webhook endpoint. If omitted, the digest prints to stdout only.
NOTIFY_WEBHOOK_URL=

# Optional tuning.
FEED_EVENT_PAGES=3
FEED_PER_PAGE=100
FEED_WINDOW_HOURS=36
FEED_MAX_REPOS=30
FEED_MAX_PAPERS=8
FEED_INTERESTS=agent,coding-agent,llm,mcp,ai,rust,typescript,javascript,toolchain,bundler,vite,deno,testing,performance,skills
FEED_STATE_FILE=.state/feed-state.json
FEED_RUN_LOG_DIR=.state/runs
# FEED_ONLY_NEW=true
# FEED_OUTPUT_FORMAT=json

# RSS/Atom feeds are loaded from the repository feeds.json file.
# RSS_FEEDS_FILE=feeds.json
# Defaults to the industry-feeds.json packaged with rss-summary, independent of cwd.
# An explicit override must exist.
# INDUSTRY_SOURCES_FILE=/absolute/path/to/industry-feeds.json
# INDUSTRY_STATE_FILE=.state/industry-state.json
# Inline overrides are isolated: RSS_FEEDS=... and INDUSTRY_SOURCES=...
# INDUSTRY_FEEDS and INDUSTRY_FEEDS_FILE remain compatibility aliases.

# Required by the default Doubao mode (not by Grok mode).
DOUBAO_SEARCH_API_KEY=
# NEWS_TOPICS_FILE=/absolute/path/to/rss-summary/news-topics.json
# NEWS_SEARCH_COUNT_PER_QUERY=10
# NEWS_SEARCH_TIMEOUT_MS=15000

# Opt-in: Doubao first; GLM fills failed or empty-after-validation queries.
# NEWS_SEARCH_MODE=hybrid
# NEWS_SEARCH_MODE=combined # Both providers; evaluate complementary coverage.
GLM_CODING_API_KEY=
# Per news-window run, not per query. No automatic paid API fallback.
# NEWS_GLM_MAX_SEARCHES=14
# NEWS_GLM_MAX_READS=14
# Optional Reader fallback after browser AND HTTP research fail in auto mode.
# RSS_ARTICLE_GLM_FALLBACK=true

# Opt-in native X search with an already installed/authenticated Grok CLI.
# Applies to noon/evening news and Daily AI; see docs/grok-x-search.md.
# NEWS_SEARCH_MODE=grok
# NEWS_GROK_EXECUTABLE=grok
# NEWS_GROK_MODEL=your-model-id # Omit to use the CLI default.
# NEWS_GROK_TIMEOUT_MS=120000
# NEWS_GROK_MAX_QUERIES=1 # Hard per-run cap, also applies to Daily AI.
# NEWS_SEARCH_DAILY_LIMIT=4 # Grok-mode default; other modes default to 14.
# NEWS_SEARCH_MONTHLY_LIMIT=120 # Grok-mode default; other modes default to 420.
# NEWS_SEARCH_CACHE_TTL_MINUTES=360
# NEWS_SEARCH_STATE_FILE=/persistent/private/news-search.json
